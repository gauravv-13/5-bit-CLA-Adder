Va2 a2 gnd PULSE(0 {SUPPLY} 0n 0n 0n 10n 20n)
Vb2 b2 gnd PULSE(0 {SUPPLY} 5n 0n 0n 10n 20n)

Va3 a3 gnd PULSE(0 {SUPPLY} 0n 0n 0n 10n 20n)
Vb3 b3 gnd PULSE(0 {SUPPLY} 5n 0n 0n 10n 20n)

Va4 a4 gnd PULSE(0 {SUPPLY} 0n 0n 0n 10n 20n)
Vb4 b4 gnd PULSE(0 {SUPPLY} 5n 0n 0n 10n 20n)

.tran 0.1n 40n
.control
run
plot v(a0) v(b0)-2 v(p0)-4 v(g0)-6
plot v(a1) v(b1)-2 v(p1)-4 v(g1)-6
plot v(a2) v(b2)-2 v(p2)-4 v(g2)-6
plot v(a3) v(b3)-2 v(p3)-4 v(g3)-6
plot v(a4) v(b4)-2 v(p4)-4 v(g4)-6
.endc
.end